# Gemini API (AI Studio). Required for the live ADK + Gemini 3.5 path.
# The sample queue still drains with the tool planner if this is unset.
GOOGLE_API_KEY=

# Optional alias
# GEMINI_API_KEY=

# Must be Gemini 3.5 or newer for the hackathon.
GEMINI_MODEL=gemini-3.5-flash

# Set true to use Vertex AI instead of the Gemini API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=tarka-505801
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud Run / emulator. Leave unset for the local file store.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

PUBSUB_TOPIC=nightdesk-shifts
FIRESTORE_COLLECTION=nightdesk

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:43148
NIGHTDESK_PORT=43148
